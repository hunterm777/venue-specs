      "name": "Kalshi binary taker, 100 at $0.50 (PRD)",
      "kind": "prd",
      "venue": "kalshi",
      "product": "binary",
      "path": "fees.taker.fee",
      "at": "2026-11-24",
      "inputs": {
        "C": "100",
        "P": "0.50"
      },
      "rows": [],
      "prd_expected": "1.75",
      "expect_error": "unverified",
      "why": "The fee schedule that gives the taker coefficient (kalshi.com/fee-schedule) could not be read, so fees.taker.model_fee is unverified."
